#!/bin/sh
#
# Pre-push hook — runs the full verification suite before allowing a push.
# This includes tests and any lifecycle checks bound to the Maven verify phase.
#

echo "🛡️  Running pre-push verification..."

# Toolchain: project targets Java 21 (Temurin preferred; error-prone breaks on newer JDKs).
if [ -z "$JAVA_HOME" ]; then
    if [ -d "$HOME/.jdk/jdk-21.0.12.1+1" ]; then
        export JAVA_HOME="$HOME/.jdk/jdk-21.0.12.1+1"
    fi
fi
# Writable upload dir for file-upload tests (default /app/uploads is not writable outside docker).
export UPLOAD_DIR="${UPLOAD_DIR:-/tmp/lions-uploads}"
# Small pool: the suite holds many Spring contexts; don't exhaust a shared DB.
./mvnw verify -q -Dspring.datasource.hikari.maximum-pool-size=2
RESULT=$?

if [ "$RESULT" -ne 0 ]; then
    echo ""
    echo "❌ Verification failed. Push aborted."
    echo "   Fix the issues before pushing, or use --no-verify to bypass."
    exit 1
fi

echo "✅ All checks pass. Proceeding with push."
exit 0