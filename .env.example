# Ports (defaults avoid clashes with common local services)
PG_PORT=5433
API_PORT=8081

# Database
POSTGRES_USER=lions_club
POSTGRES_PASSWORD=lions_club_dev
POSTGRES_DB=lions_club

# Application (host runs; the compose API service uses the db service instead)
DB_URL=jdbc:postgresql://localhost:5433/lions_club
DB_USERNAME=lions_club
DB_PASSWORD=lions_club_dev

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT (override in production)
JWT_SECRET=CHANGEME_IN_PRODUCTION_dev_secret_key_lions_club_fsbm_2026
